//////////////////////////////////////////////////////////////////////
// PART 1 - WHAT YOU BUILD (mapgroupproto.xml concept)
// ////////////////////////////////////////////////////////////////////

<group name="MilitaryLootBase">

    <!--
    This group defines a FULL STRUCTURE SET

    Think of it as a "prefab base"
    Everything inside will ALWAYS spawn together
    -->



    <!-- MAIN BUILDING -->
    <child
        name="Land_Mil_GuardHouse1"
        pos="0 0 0"
        rpy="0 0 0"
    />



    <!-- STORAGE AREA -->
    <child
        name="Land_Mil_CamoNet"
        pos="2 0 3"
        rpy="0 0 0"
    />



    <!-- LOOT COVER -->
    <child
        name="Land_BagFence_Long"
        pos="-4 0 2"
        rpy="0 0 90"
    />



    <!-- LOOT COVER -->
    <child
        name="Land_BagFence_Long"
        pos="4 0 2"
        rpy="0 0 90"
    />



    <!-- CRATE AREA -->
    <child
        name="Land_WoodenCrate"
        pos="0 0 -3"
        rpy="0 0 0"
    />

</group>



//////////////////////////////////////////////////////////////////////
// PART 2 - WHERE IT SPAWNS (mapgrouppos.xml concept)
// ////////////////////////////////////////////////////////////////////

<group name="MilitaryLootBase" pos="5200 7800" />

<!--
This places the entire structure at:

X = 5200
Z = 7800

Everything defined in proto spawns here automatically
-->



