//////////////////////////////////////////////////////////////////////
// DAYZ MAPCLUSTERS.XML - COMPLETE LEARNING FILE
//
// PURPOSE:
// This file controls CLUSTER SPAWNING for the Central Economy (CE)
//
// Unlike mapgroupproto/mapgrouppos (which spawn structures),
// mapclusters.xml controls:
//
// - WHERE loot naturally spawns in the world
// - HOW loot is grouped in regions
// - DENSITY of loot zones
//
// THINK OF IT AS:
//
// mapgroupproto  = built structures
// mapgrouppos     = where structures go
// mapclusters.xml = where loot naturally spawns in the environment
//////////////////////////////////////////////////////////////////////



//////////////////////////////////////////////////////////////////////
// BASIC CLUSTER STRUCTURE
//////////////////////////////////////////////////////////////////////

<cluster name="Military">

    <!--
    NAME:
    Defines a loot "region type"

    Examples:
    - Military
    - Industrial
    - Residential
    - Farm
    -->



    //////////////////////////////////////////////////////////////////
    // POSITION AREA
    //////////////////////////////////////////////////////////////////

    <position x="5000" z="7000" radius="200" />

    <!--
    x = world X coordinate
    z = world Z coordinate
    radius = how far loot spreads

    This defines a LOOT ZONE AREA
    -->



    //////////////////////////////////////////////////////////////////
    // LOOT TYPES INSIDE CLUSTER
    //////////////////////////////////////////////////////////////////

    <type name="AKM" chance="0.05" />

    <type name="M4A1" chance="0.03" />

    <type name="AmmoBox_545x39_20Rnd" chance="0.20" />

    <type name="BandageDressing" chance="0.60" />



    <!--
    type = item classname from types.xml

    chance = spawn probability inside cluster

    Higher chance = more common loot
    Lower chance = rare loot
    -->

</cluster>



//////////////////////////////////////////////////////////////////////
// HOW CLUSTERS WORK (IMPORTANT)
//////////////////////////////////////////////////////////////////////

/*
CLUSTERS DO NOT SPAWN BUILDINGS.

They ONLY influence:

- loot distribution
- loot density
- loot types in region

Buildings still come from:
mapgroupproto.xml + mapgrouppos.xml
*/



//////////////////////////////////////////////////////////////////////
// MILITARY CLUSTER EXAMPLE
//////////////////////////////////////////////////////////////////////

<cluster name="Military">

    <position x="4500" z="8200" radius="300" />

    <type name="AKM" chance="0.04" />
    <type name="M4A1" chance="0.02" />
    <type name="PlateCarrierVest" chance="0.03" />

    <type name="AmmoBox_556x45_20Rnd" chance="0.25" />
    <type name="BandageDressing" chance="0.70" />

</cluster>



RESULT:

- high tier loot near military zones
- more weapon spawns
- more tactical gear



//////////////////////////////////////////////////////////////////////
// INDUSTRIAL CLUSTER EXAMPLE
//////////////////////////////////////////////////////////////////////

<cluster name="Industrial">

    <position x="6000" z="5000" radius="250" />

